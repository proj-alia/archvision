{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extension Manifest Protocol 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "manifest_version": {
      "const": "1.0"
    },
    "extension_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "package_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "host_protocol_range": {
      "type": "string",
      "minLength": 1
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "runtime_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
          },
          "artifact_ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "runtime_id",
          "artifact_ref",
          "sha256"
        ]
      },
      "minItems": 1
    },
    "requested_permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "scope",
          "actions",
          "reason"
        ]
      },
      "minItems": 0
    },
    "provides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract_ref"
      },
      "minItems": 0
    },
    "uses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contract_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
          },
          "version_range": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "contract_id",
          "version_range",
          "required"
        ]
      },
      "minItems": 0
    },
    "contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contribution_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
          },
          "type_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
          },
          "contract_ref": {
            "$ref": "#/$defs/contract_ref"
          },
          "descriptor_ref": {
            "$ref": "#/$defs/package_resource_ref"
          }
        },
        "required": [
          "contribution_id",
          "type_id",
          "contract_ref"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "type_id": {
                  "const": "alia.contribution.connector"
                }
              },
              "required": [
                "type_id"
              ]
            },
            "then": {
              "required": [
                "descriptor_ref"
              ],
              "properties": {
                "contract_ref": {
                  "properties": {
                    "contract_id": {
                      "const": "alia.connector.management"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type_id": {
                  "const": "alia.contribution.protocol-adapter"
                }
              },
              "required": [
                "type_id"
              ]
            },
            "then": {
              "required": [
                "descriptor_ref"
              ]
            }
          }
        ]
      },
      "minItems": 0
    },
    "isolation_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "cpu_millis": {
          "type": "integer",
          "minimum": 1
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "profile_id",
        "memory_bytes",
        "cpu_millis",
        "max_concurrency"
      ]
    }
  },
  "required": [
    "protocol_version",
    "manifest_version",
    "extension_id",
    "package_version",
    "host_protocol_range",
    "entrypoints",
    "requested_permissions",
    "provides",
    "uses",
    "contributions",
    "isolation_requirements"
  ],
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "identity_id": {
          "type": "string",
          "minLength": 1
        },
        "branch_id": {
          "type": "string",
          "minLength": 1
        },
        "access_scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tenant_id",
        "identity_id",
        "branch_id",
        "access_scope"
      ]
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "private",
            "restricted"
          ]
        },
        "retention_policy_id": {
          "type": "string",
          "minLength": 1
        },
        "lineage_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "owner_id",
        "purpose",
        "classification",
        "retention_policy_id",
        "lineage_ids"
      ]
    },
    "contract_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "schema_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "contract_id",
        "version",
        "schema_digest"
      ]
    },
    "read_set": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resource_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "resource_id",
          "kind",
          "revision"
        ]
      },
      "minItems": 1
    },
    "package_resource_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_-][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    }
  },
  "$comment": "Unpublished first-version design draft. Structural validation does not prove runtime behavior."
}
