{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Connector Setup Session 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "data_policy": {
      "$ref": "#/$defs/data_policy"
    },
    "setup_id": {
      "type": "string",
      "minLength": 1
    },
    "connector_id": {
      "type": "string",
      "minLength": 1
    },
    "definition_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "definition_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "definition_id",
        "version",
        "sha256"
      ]
    },
    "configuration_revision": {
      "type": "integer",
      "minimum": 1
    },
    "extension_session_id": {
      "type": "string",
      "minLength": 1
    },
    "extension_generation": {
      "type": "integer",
      "minimum": 1
    },
    "operator_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "awaiting_input",
        "processing",
        "succeeded",
        "failed",
        "cancelled",
        "expired"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "form",
            "qr",
            "link",
            "notice"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "input_schema": {
          "type": "object"
        },
        "asset": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "blob_ref": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "blob_ref",
            "sha256",
            "expires_at"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      },
      "required": [
        "step_id",
        "revision",
        "kind",
        "text"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "form"
              }
            }
          },
          "then": {
            "required": [
              "input_schema"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "qr"
              }
            }
          },
          "then": {
            "required": [
              "asset"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "link"
              }
            }
          },
          "then": {
            "required": [
              "url"
            ]
          }
        }
      ]
    },
    "credential_refs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "diagnostic_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "data_policy",
    "setup_id",
    "connector_id",
    "definition_ref",
    "configuration_revision",
    "extension_session_id",
    "extension_generation",
    "operator_id",
    "revision",
    "state",
    "created_at",
    "updated_at",
    "expires_at",
    "credential_refs"
  ],
  "$defs": {
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "private",
            "restricted"
          ]
        },
        "retention_policy_id": {
          "type": "string",
          "minLength": 1
        },
        "lineage_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "owner_id",
        "purpose",
        "classification",
        "retention_policy_id",
        "lineage_ids"
      ]
    }
  },
  "$comment": "Unpublished first-version design draft. Structural validation does not prove runtime behavior.",
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "awaiting_input"
          }
        }
      },
      "then": {
        "required": [
          "step"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "succeeded",
              "failed",
              "cancelled",
              "expired"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "step"
          ]
        }
      }
    }
  ],
  "description": "Temporary setup for an interaction instance; not an extension runtime session."
}
