{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consumer Provider Binding Protocol 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "binding_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_ref": {
      "$ref": "#/$defs/contract_ref"
    },
    "consumer_principal_id": {
      "type": "string",
      "minLength": 1
    },
    "consumer_session_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_session_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_generation": {
      "type": "integer",
      "minimum": 1
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 1
    },
    "revocation_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "revoked",
        "expired",
        "withdrawn"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "resource_ref": {
      "$ref": "#/$defs/resource_ref"
    }
  },
  "required": [
    "protocol_version",
    "scope",
    "binding_id",
    "contract_ref",
    "consumer_principal_id",
    "consumer_session_id",
    "provider_session_id",
    "provider_generation",
    "authorization_ref",
    "revocation_epoch",
    "state",
    "issued_at",
    "expires_at"
  ],
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "identity_id": {
          "type": "string",
          "minLength": 1
        },
        "branch_id": {
          "type": "string",
          "minLength": 1
        },
        "access_scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tenant_id",
        "identity_id",
        "branch_id",
        "access_scope"
      ]
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "private",
            "restricted"
          ]
        },
        "retention_policy_id": {
          "type": "string",
          "minLength": 1
        },
        "lineage_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "owner_id",
        "purpose",
        "classification",
        "retention_policy_id",
        "lineage_ids"
      ]
    },
    "contract_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "schema_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "contract_id",
        "version",
        "schema_digest"
      ]
    },
    "read_set": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resource_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "resource_id",
          "kind",
          "revision"
        ]
      },
      "minItems": 1
    },
    "resource_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        },
        "resource_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type_id",
        "resource_id"
      ]
    }
  },
  "$comment": "Unpublished first-version design draft. Structural validation does not prove runtime behavior.",
  "allOf": [
    {
      "if": {
        "properties": {
          "contract_ref": {
            "properties": {
              "contract_id": {
                "enum": [
                  "alia.connector.management",
                  "alia.connector.setup",
                  "alia.interaction"
                ]
              }
            },
            "required": [
              "contract_id"
            ]
          }
        },
        "required": [
          "contract_ref"
        ]
      },
      "then": {
        "required": [
          "resource_ref"
        ],
        "properties": {
          "resource_ref": {
            "properties": {
              "type_id": {
                "const": "connector.instance"
              }
            }
          }
        }
      }
    }
  ]
}
