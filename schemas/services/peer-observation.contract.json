{
  "protocol_version": "1.0",
  "contract_id": "alia.peer.observation",
  "version": "1.0.0",
  "methods": [],
  "events": [
    {
      "name": "observe",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "observation_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "create",
              "revise",
              "retract"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "content_parts": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "text"
                    },
                    "text": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "kind",
                    "text"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "reference"
                    },
                    "type_id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
                    },
                    "contract_ref": {
                      "$ref": "#/$defs/contract_ref"
                    },
                    "blob_ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mime": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "captured_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "consent_ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "type_id",
                    "contract_ref",
                    "blob_ref",
                    "mime",
                    "sha256",
                    "captured_at",
                    "expires_at",
                    "consent_ref"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "typed"
                    },
                    "type_id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
                    },
                    "contract_ref": {
                      "$ref": "#/$defs/contract_ref"
                    },
                    "payload": {}
                  },
                  "required": [
                    "kind",
                    "type_id",
                    "contract_ref",
                    "payload"
                  ]
                }
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "observation_id",
          "revision",
          "kind",
          "source_ref",
          "occurred_at",
          "content_parts"
        ],
        "$defs": {
          "contract_ref": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "contract_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
              },
              "schema_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "contract_id",
              "version",
              "schema_digest"
            ]
          }
        }
      }
    }
  ],
  "streams": []
}
