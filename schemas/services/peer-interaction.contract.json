            "then": {
              "properties": {
                "content_parts": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "create",
                    "revise",
                    "signal"
                  ]
