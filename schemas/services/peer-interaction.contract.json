    {
      "name": "receipt",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "output_delivery_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "started",
              "partial",
              "completed",
              "interrupted",
              "failed",
              "suppressed"
            ]
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "segment_id": {
                  "type": "string",
                  "minLength": 1
