                "channel_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
                },
                "content_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "offset_unit": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
                },
                "from": {
                  "type": "integer",
                  "minimum": 0
                },
                "to": {
                  "type": "integer",
                  "minimum": 0
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "delivered",
                    "interrupted",
                    "failed"
                  ]
                },
                "recorded_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "audience_refs": {
                  "type": "array",
