        "required": [
          "output_delivery_id",
          "status",
          "recorded_at",
          "segments"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "partial",
                    "completed"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "segments": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "suppressed"
                }
              }
            },
            "then": {
              "properties": {
                "segments": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
