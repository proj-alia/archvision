{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expression Intent 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "data_policy": {
      "$ref": "#/$defs/data_policy"
    },
    "expression_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "speech_act": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "content_parts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "text"
              },
              "text": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "required": [
              "kind",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "reference"
              },
              "type_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
              },
              "contract_ref": {
                "$ref": "#/$defs/contract_ref"
              },
              "blob_ref": {
                "type": "string",
                "minLength": 1
              },
              "mime": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "captured_at": {
                "type": "string",
                "format": "date-time"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              },
              "consent_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "type_id",
              "contract_ref",
              "blob_ref",
              "mime",
              "sha256",
              "captured_at",
              "expires_at",
              "consent_ref"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "typed"
              },
              "type_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
              },
              "contract_ref": {
                "$ref": "#/$defs/contract_ref"
              },
              "payload": {}
            },
            "required": [
              "kind",
              "type_id",
              "contract_ref",
              "payload"
            ]
          }
        ]
      },
      "minItems": 1
    },
    "tone": {
      "type": "string",
      "minLength": 1
    },
    "intensity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nonverbal_hints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "delivery_policy": {
      "type": "string",
      "enum": [
        "text_only",
        "any_supported",
        "silent"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "read_set": {
      "$ref": "#/$defs/read_set"
    }
  },
  "required": [
    "schema_version",
    "scope",
    "data_policy",
    "expression_id",
    "decision_id",
    "audience",
    "speech_act",
    "delivery_policy",
    "expires_at",
    "read_set"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "delivery_policy": {
            "const": "text_only"
          }
        }
      },
      "then": {
        "required": [
          "text"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "delivery_policy": {
            "const": "any_supported"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "text"
            ]
          },
          {
            "required": [
              "content_parts"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "delivery_policy": {
            "const": "silent"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "text"
              ]
            },
            {
              "required": [
                "content_parts"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "identity_id": {
          "type": "string",
          "minLength": 1
        },
        "branch_id": {
          "type": "string",
          "minLength": 1
        },
        "access_scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tenant_id",
        "identity_id",
        "branch_id",
        "access_scope"
      ]
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "private",
            "restricted"
          ]
        },
        "retention_policy_id": {
          "type": "string",
          "minLength": 1
        },
        "lineage_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "owner_id",
        "purpose",
        "classification",
        "retention_policy_id",
        "lineage_ids"
      ]
    },
    "contract_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "schema_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "contract_id",
        "version",
        "schema_digest"
      ]
    },
    "read_set": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resource_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "resource_id",
          "kind",
          "revision"
        ]
      },
      "minItems": 1
    }
  },
  "$comment": "Unpublished first-version design draft. Structural validation does not prove runtime behavior."
}
