{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic Q7 fixture, not a real platform protocol",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "Q7"
        },
        "op": {
          "const": "user.say"
        },
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "room": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "protocol",
        "op",
        "speaker",
        "room",
        "text"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "Q7"
        },
        "op": {
          "const": "display.text"
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "protocol",
        "op",
        "operation",
        "text"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "Q7"
        },
        "op": {
          "const": "counter.add"
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [
        "protocol",
        "op",
        "operation",
        "amount"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "Q7"
        },
        "op": {
          "const": "counter.result"
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "effect_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "protocol",
        "op",
        "operation",
        "value",
        "effect_ref"
      ]
    }
  ]
}
