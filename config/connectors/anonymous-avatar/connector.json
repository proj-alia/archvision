{
  "schema_version": "1.0",
  "definition_id": "org.example.avatar.connector",
  "version": "1.0.0",
  "display_name": "匿名角色客户端 C",
  "description": "合成协议 C7 的双向桥接设计，不代表任何实际 Live2D 客户端协议。",
  "execution_location": "server",
  "management_contract": {
    "contract_id": "alia.connector.management",
    "version": "1.0.0",
    "schema_digest": "df197010a5ab2c5237fa157c5cc7bd5c166d3574c2a0b0fb26df1e4abaee0c21"
  },
  "interaction_contract": {
    "contract_id": "alia.interaction",
    "version": "1.0.0",
    "schema_digest": "5c70160439bcc023afb2aa652896c39786f91b3b6d8b3022ddc490e00bc54f7a"
  },
  "configuration_version": "1.0.0",
  "configuration_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "endpoint": {
        "type": "string",
        "format": "uri",
        "pattern": "^wss://"
      },
      "peer_protocol": {
        "const": "C7"
      },
      "client_ref": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "endpoint",
      "peer_protocol",
      "client_ref"
    ]
  },
  "ui_hints": [
    {
      "path": "/endpoint",
      "label": "客户端桥接地址"
    },
    {
      "path": "/peer_protocol",
      "label": "外部协议版本"
    },
    {
      "path": "/client_ref",
      "label": "已配对客户端"
    }
  ],
  "credential_slots": [
    {
      "slot_id": "token",
      "label": "访问令牌",
      "required": true,
      "entry_mode": "manual"
    }
  ],
  "features": [
    "interaction.input.text",
    "interaction.output.text",
    "avatar.motion"
  ],
  "required_features": [
    "interaction.input.text",
    "interaction.output.text"
  ],
  "connection_dependents": [
    {
      "contribution_id": "org.example.avatar.expression",
      "required_features": [
        "avatar.motion"
      ]
    }
  ]
}
