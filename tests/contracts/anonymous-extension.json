  "scenarios": [
    {
      "id": "unknown_type",
      "given": "Core types are frozen before X/Y are authored.",
      "events": [
        "x.validated",
        "x.ready",
        "y.ready",
        "binding.created",
        "observation.received"
      ],
      "assertions": [
        "No X/Y business branch in core",
        "Payload schema is registered and checked",
        "Only authorized projection reaches cognition"
      ]
    },
    {
      "id": "late_dependency",
      "given": "Y starts before X.",
      "events": [
        "y.waiting_dependencies",
        "x.ready",
        "y.starting",
        "y.ready"
      ],
      "assertions": [
        "No setup before dependencies",
        "Snapshot resolution prevents missed readiness"
      ]
    },
    {
      "id": "cycle_conflict",
      "given": "Required dependency cycle or duplicate provider.",
      "events": [
        "activation.rejected"
      ],
      "assertions": [
        "Diagnostic identifies cycle/conflict",
        "No partial registration"
      ]
    },
    {
      "id": "setup_rollback",
      "given": "X publishes one of two reserved declarations, then fails.",
      "events": [
        "registration.reserved",
        "setup.failed",
        "registration.rolled_back"
      ],
      "assertions": [
        "No provider is externally ready",
        "All reservations released"
      ]
    },
    {
      "id": "stop_during_setup",
      "given": "Setup returns after stop.",
      "events": [
        "session.stopping",
        "session.stopped",
        "setup.late_return"
      ],
      "assertions": [
        "No late publication",
        "Old cleanup cannot revoke replacement"
      ]
    },
    {
      "id": "provider_replacement",
      "given": "Generation 2 replaces generation 1 during a call.",
      "events": [
        "binding.revoked",
        "provider.ready",
        "result.late"
      ],
      "assertions": [
        "Old result cannot commit stale state",
        "Uncertain effects reconciled",
        "New binding targets generation 2"
      ]
    },
    {
      "id": "revocation",
      "given": "Consent revoked after proposal, before dispatch.",
      "events": [
        "decision.proposed",
        "privacy.consent.revoked",
        "action.rejected"
      ],
      "assertions": [
        "No external dispatch",
        "No stream continues after revoke"
      ]
    },
    {
      "id": "data_congestion",
      "given": "Data queue reaches limit.",
      "events": [
        "stream.backpressured",
        "control.cancel",
        "session.stopped"
      ],
      "assertions": [
        "Control remains responsive",
        "Gap reported for lossy observations"
      ]
    },
    {
      "id": "disconnect",
      "given": "Connection drops after a write was dispatched.",
      "events": [
        "binding.withdrawn",
        "action.uncertain",
        "runtime.reconnected"
      ],
      "assertions": [
        "No blind effect replay",
        "Reauth and new binding",
        "Resume only with supported cursor"
      ]
    },
    {
      "id": "delete_race",
      "given": "A summarizer read data before deletion.",
      "events": [
        "privacy.deletion.requested",
        "barrier.advanced",
        "candidate.rejected"
      ],
      "assertions": [
        "No stale derived write",
        "Backup restore honors tombstone"
      ]
    },
    {
      "id": "history_after_uninstall",
      "given": "X is removed after legitimate use.",
      "events": [
        "provider.withdrawn",
        "context.revoked",
        "self.capability.updated"
      ],
      "assertions": [
        "History retains versioned evidence",
        "SelfModel reports current unavailability",
        "Deleted private data remains inaccessible"
      ]
    },
    {
      "id": "egress_audience_change",
      "given": "Audience changes while generation is in flight.",
      "events": [
        "decision.proposed",
        "audience.changed",
        "egress.rejected"
      ],
      "assertions": [
        "No cached private response sent",
        "Recompile before new delivery"
      ]
    },
    {
      "id": "partial_delivery",
      "given": "Text delivered, another projection interrupted.",
      "events": [
        "expression.delivery.started",
        "expression.delivery.interrupted"
      ],
      "assertions": [
        "Receipts preserve per-channel ranges",
        "Delivered does not imply understood"
      ]
    },
    {
      "id": "cross_scene_continuity",
      "given": "A joint project pauses and resumes in a new permitted scene.",
      "events": [
        "commitment.paused",
        "context.rebuilt",
        "commitment.resumed"
      ],
      "assertions": [
        "Same identity and authorized history",
        "No invented activity during downtime"
      ]
    },
    {
      "id": "learning_transfer",
      "given": "A correction is evaluated in held-out tasks.",
      "events": [
        "learning.proposed",
        "learning.evaluated",
        "learning.committed"
      ],
      "assertions": [
        "Behavior changes in relevant unseen cases",
        "Ablation separates architecture effect",
        "No hardcoded novel dialogue"
      ]
    }
  ]
